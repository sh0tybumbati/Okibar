# Server Configuration
PORT=5000

# YouTube API Configuration
# Get your API key from: https://console.developers.google.com/
# 1. Create a new project or select existing
# 2. Enable YouTube Data API v3
# 3. Create credentials (API Key)
# 4. Restrict the key to YouTube Data API v3
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# React App Configuration
REACT_APP_SERVER_URL=http://localhost:5000
REACT_APP_API_URL=http://localhost:5000/api

# --- Optional: Local Archiving (yt-dlp) ---
# Path to yt-dlp binary. Auto-detected in common locations if not set.
# CANTINA_YTDLP_PATH=/usr/local/bin/yt-dlp

# Directory for downloaded media files (defaults to server/media)
# CANTINA_MEDIA_DIR=/path/to/media

# Maximum media storage in GB before LRU eviction (default: 5)
# CANTINA_MAX_MEDIA_GB=5

# --- Optional: State Persistence ---
# Path to the state persistence file (defaults to server/state.json)
# CANTINA_STATE_FILE=/path/to/state.json